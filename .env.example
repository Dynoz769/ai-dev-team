# Anthropic API key (https://console.anthropic.com). Not needed if you ran `ant auth login`.
ANTHROPIC_API_KEY=

# Absolute path to the git repo your AI team works on.
WORKSPACE_DIR=/path/to/your/project

# Command QA runs to test the code (leave empty to skip automated tests).
TEST_COMMAND=npm test

# Model used by every agent.
MODEL=claude-opus-5-5

# Port for the dashboard.
PORT=3000

# Monthly budget shown in the usage meter, in USD.
MONTHLY_BUDGET_USD=500

# Set to 1 to run the whole pipeline with fake agents (no API calls, no cost).
MOCK=0
