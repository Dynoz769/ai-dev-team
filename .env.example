# You don't need to edit this file: use the Settings button in the app instead.

# Anthropic API key (https://console.anthropic.com). Without one, the app runs in practice mode.
ANTHROPIC_API_KEY=

# Absolute path to the git project your AI team works on. Empty = the built-in demo project.
WORKSPACE_DIR=

# Command QA runs to test the code (leave empty to skip automated tests).
TEST_COMMAND=

# Model used by every agent.
MODEL=claude-opus-5-5

# Port for the dashboard.
PORT=3000

# Monthly budget shown in the usage meter, in USD.
MONTHLY_BUDGET_USD=500

# 1 = practice mode (scripted agents, no API calls). Empty = practice mode until you add an API key.
MOCK=
